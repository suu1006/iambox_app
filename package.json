{
  "name": "iambox-app",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev:mobile": "pnpm --filter @iambox/mobile start",
    "typecheck:mobile": "pnpm --filter @iambox/mobile typecheck",
    "dev:api": "pnpm --filter @iambox/api dev",
    "build:api": "pnpm --filter @iambox/api build",
    "typecheck:api": "pnpm --filter @iambox/api typecheck",
    "typecheck:shared": "pnpm --filter @iambox/contracts --filter @iambox/utils --filter @iambox/design-tokens --filter @iambox/ui typecheck",
    "test:shared": "pnpm --filter @iambox/utils --filter @iambox/ui test"
  },
  "devDependencies": {
    "eslint": "^10.11.0"
  }
}
