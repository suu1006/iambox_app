diff --git a/ios/Util/Image/BoundedImageCache.h b/ios/Util/Image/BoundedImageCache.h
new file mode 100644
index 0000000000000000000000000000000000000000..9aaa7af1a4ac5b95414c0e5360ac5142681df807
--- /dev/null
+++ b/ios/Util/Image/BoundedImageCache.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <algorithm>
+#include <deque>
+#include <string>
+#include <unordered_map>
+
+// Bounded ownership; mounted overlays retain their own image after eviction.
+template <typename T> class NaverMapBoundedImageCache {
+  const size_t capacity;
+  std::unordered_map<std::string, T> images;
+  std::deque<std::string> insertionOrder;
+public:
+  explicit NaverMapBoundedImageCache(size_t limit = 128) : capacity(std::max<size_t>(1, limit)) {}
+  T get(const std::string& key) const {
+    auto found = images.find(key);
+    return found == images.end() ? T{} : found->second;
+  }
+  size_t size() const { return images.size(); }
+  void put(const std::string& key, T image) {
+    if (images.find(key) == images.end()) {
+      while (images.size() >= capacity) {
+        images.erase(insertionOrder.front());
+        insertionOrder.pop_front();
+      }
+      insertionOrder.push_back(key);
+    }
+    images[key] = image;
+  }
+};
